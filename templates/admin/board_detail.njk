{% include "partials/header.njk" %}
<p class="breadcrumb"><a href="/admin/boards">Boards</a> / {{ board.name }}</p>
<h1>Manage board: {{ board.name }}</h1>

<section class="panel">
    <h2>Settings</h2>
    <form method="post" action="/admin/boards/{{ board.id }}" class="stack">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label>Name
            <input type="text" name="name" required maxlength="100" value="{{ board.name }}">
        </label>
        <label>Description
            <input type="text" name="description" maxlength="500" value="{{ board.description }}">
        </label>
        <label class="checkbox">
            <input type="checkbox" name="default_access" value="1" {{ 'checked' if board.default_access == 1 }}>
            Grant access to all users automatically
        </label>
        <button type="submit" class="btn btn-primary">Save settings</button>
    </form>
</section>

<section class="panel">
    <h2>Users with explicit access ({{ access_list | default([], true) | length }})</h2>
    {% if access_list | default([], true) | length == 0 %}
        <p class="empty-state">No users have been granted explicit access to this board.</p>
    {% else %}
        <table class="table">
            <thead><tr><th>User</th><th>Email</th><th>Granted</th><th></th></tr></thead>
            <tbody>
            {% for a in access_list %}
                <tr>
                    <td>{{ a.username }}</td>
                    <td class="muted">{{ a.email }}</td>
                    <td><time>{{ a.granted_at }}</time></td>
                    <td>
                        <form method="post" action="/admin/boards/{{ board.id }}/access" class="inline-form">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <input type="hidden" name="user_id" value="{{ a.id }}">
                            <input type="hidden" name="action" value="revoke">
                            <button type="submit" class="btn btn-sm btn-danger">Revoke</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>

<section class="panel">
    <h2>Grant access</h2>
    <form method="post" action="/admin/boards/{{ board.id }}/access" class="stack">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="grant">
        <div class="form-row">
            <label>User
                <select name="user_id" required>
                    {% for u in all_users | default([], true) %}
                        <option value="{{ u.id }}">{{ u.username }} ({{ u.email }})</option>
                    {% endfor %}
                </select>
            </label>
            <button type="submit" class="btn btn-primary">Grant</button>
        </div>
    </form>
</section>
{% include "partials/footer.njk" %}
