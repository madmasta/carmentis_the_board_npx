# ---- Application ----
APP_NAME="The Board"
APP_URL=http://localhost:8088
APP_DEBUG=0

# ---- Database ----
# Node target runs its own MariaDB container on host port 3307 so the PHP
# reference target can keep 3306 and both can be measured side by side
# (docs/07-port-deviations.md section 9).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=theboard_node
DB_USER=theboard
DB_PASS=theboard
# Only used by the test bootstrap / seeding scripts to create databases
DB_ROOT_PASS=theboardroot
# Test database name is always "<DB_NAME>_test"; it is derived, never configured.

# ---- Node only (docs/07-port-deviations.md section 8) ----
# HTTP listen port; matches the PHP dev server port.
PORT=8088
# Bind address. 127.0.0.1 on main; a wider default is itself a misconfiguration.
HOST=127.0.0.1
# Hosts the app will answer. Default is the APP_URL host plus localhost.
# Enforced by src/http/request.js#hostIsAllowed (control C-COOKIE-1).
# HOST_ALLOWLIST=localhost,127.0.0.1
# Signing secret for reset / remember-me tokens. If absent it is generated once
# into var/secret.key.
# JWT_SECRET=
# Overrides the mail log path (used by the branch verification harness).
# MAIL_LOG=
# Names the slug of the vulnerability branch under test (set by verify:branch).
# THEBOARD_VULN=

# ---- Admins (comma separated email list) ----
# Anyone registering with one of these emails is granted the admin role.
# scripts/seed-admins.mjs provisions these accounts (password from ADMIN_PASSWORD
# or a random one printed once).
ADMIN_EMAILS=admin@theboard.example
ADMIN_PASSWORD=admintest

# ---- Mail ----
# log    = append messages to var/log/mail.log (default, good for dev)
# smtp   = send through an SMTP server
MAIL_DRIVER=log
MAIL_FROM=no-reply@theboard.local
MAIL_FROM_NAME="The Board"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# ---- Security ----
SESSION_NAME=theboard_session
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# !! DEVELOPMENT ONLY !!  Set to 1 to switch OFF the login throttle entirely:
# no limit on failed passwords, no lockout window. This removes the only
# brute-force protection the app has -- every account becomes guessable at
# whatever rate the attacker can send requests.
#
# It is ignored unless APP_DEBUG=1, every page then carries a warning banner,
# and each bypassed check is logged to var/log/app.log.
# NEVER set this on anything reachable by someone else.
LOGIN_THROTTLE_DISABLED=0
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
